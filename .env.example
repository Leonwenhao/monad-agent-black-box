# Shared local configuration for Monad Agent Black Box.
# Copy to .env or workspace-specific env files as needed.

MONAD_RPC_URL=wss://rpc.monad.xyz
# Browser registry scans need a VITE_* variable; Vite does not expose MONAD_RPC_URL.
VITE_AGENT_REGISTRY_RPC_URL=https://rpc.monad.xyz
# Optional override used by the runner; MONAD_RPC_URL is used when omitted.
RUNNER_RPC_URL=
MONAD_CHAIN_ID=143
RUNNER_PRIVATE_KEY=
TRACE_REGISTRY_ADDRESS=
DEMO_TREASURY_ACTION_ADDRESS=
VITE_TRACE_REGISTRY_ADDRESS=
VITE_DEMO_TREASURY_ACTION_ADDRESS=
VITE_MONAD_EXPLORER_BASE_URL=https://monadvision.com
# Optional URL for bundled catalog JSON (default: `${BASE_URL}catalog/8004scan-agents-monad-143.json`; refresh ids with `npm --workspace apps/web run scrape:8004scan-catalog`).
# VITE_8004SCAN_CATALOG_URL=
# Optional fallback token IDs if bundled catalog missing or fails (comma-separated).
# VITE_MOCK_REGISTRY_AGENT_IDS=
